# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=""
DB_NAME=faculty_evaluation_db

# Security & Authentication (Required at startup)
# JWT secret key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Privacy encryption key for AES-256-GCM respondent tokens (Required; MUST NOT equal JWT_SECRET)
# CRITICAL: Do NOT rotate or change once evaluations are submitted, or existing references cannot be decrypted.
PRIVACY_ENCRYPTION_KEY=your_distinct_privacy_encryption_key_here_32_bytes

# Maintenance Safeguards (Optional; default is disabled/off)
ALLOW_BULK_DELETE=false

# Privacy & Anonymity Safeguards
# Minimum number of submitted evaluations required before comments, sentiment breakdown,
# and per-theme recommendations are exposed to faculty/admin (default: 5).
MIN_EVALUATION_THRESHOLD=5

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Frontend URL
CLIENT_URL=http://localhost:5173
