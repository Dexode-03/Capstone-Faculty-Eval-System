# ──────────────────────────────────────────────
# FEFAS Backend — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# Database (MySQL)
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=faculty_evaluation_db
DB_SSL=true

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_strong_random_string
JWT_EXPIRES_IN=7d

# Privacy encryption — generate with: openssl rand -hex 32
PRIVACY_ENCRYPTION_KEY=CHANGE_ME_generate_a_different_strong_random_string

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Frontend URL (for CORS — set to your deployed frontend URL)
CLIENT_URL=https://your-frontend-url.com
